*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/app/build
/.kotlin

# Signierung — niemals ins Repository
*.jks
*.keystore
keystore.properties

# Das Store-Paket entsteht aus dem Projekt; die gebauten Fassungen darin
# gehören nicht ins Repo — nach zwei Änderungen sind sie veraltet, und
# niemand sieht ihnen das an.
storepaket/*.apk
storepaket/app/*.aab
storepaket/app/*.apk

# Von den Werkzeugen erzeugt, nicht von Hand gepflegt
werkzeuge/rechtstexte.txt
werkzeuge/spielbeschreibung.txt
werkzeuge/*.html
!werkzeuge/vorlage.html
werkzeuge/__pycache__/
